# ---- Public (safe for browser) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# GPS tuning (seconds / meters)
NEXT_PUBLIC_GPS_UPDATE_INTERVAL_SECONDS=8
NEXT_PUBLIC_GPS_MAX_ACCURACY_METERS=100
NEXT_PUBLIC_LOCATION_STALE_SECONDS=60

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Midtrans Snap (Sandbox) - used from Phase 4
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Protects Vercel Cron endpoints (location cleanup, payment expiry) - used from Phase 3/4
CRON_SECRET=generate-a-long-random-string
